#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

for arg in "$@"; do
  case "$arg" in
    --skill|--skill=*)
      printf 'crewdeck-pi: additional skills are disabled for the orchestrator\n' >&2
      exit 2
      ;;
  esac
done

exec "${PI_BIN:-pi}" \
  --no-skills \
  --skill "$ROOT/.agents/skills/crewdeck/SKILL.md" \
  "$@"
