#!/usr/bin/env node
import path from "node:path";
import { fileURLToPath } from "node:url";
import {
  abandonTask,
  addProject,
  cleanupTask,
  collectResults,
  getStatusView,
  readResultDetail,
  getTaskDiff,
  loadConfig,
  forwardReviewFindings,
  forwardBaseAdvance,
  extendReviewRounds,
  mergeTask,
  observePublishedPullRequests,
  prepareIntegration,
  promptTask,
  publishPullRequest,
  reconcileMergedPullRequest,
  reconcileOrphanReport,
  reconcileVerdictComment,
  recoverStateLock,
  retireTaskAgent,
  resumeBuild,
  stateLockStatus,
  spawnBatch,
  spawnReview,
  stateLocation,
} from "../src/core.mjs";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const configPath = process.env.CREWDECK_CONFIG || path.join(root, "crewdeck.json");
const [command, ...args] = process.argv.slice(2);

function usage() {
  console.log(`Crewdeck v0.3

Usage:
  crewdeck config
  crewdeck project add <name> <path> [--base <branch>] [--base-remote <remote>] [--trust]
  crewdeck project list
  crewdeck spawn <project> <kind> <id> <task> [--profile <name>] [--reviewed-pr]
  crewdeck review <parent-id> <review-id> <reviewed-head> <task> [--profile <name>]
  crewdeck status [id] [--scope active|history|all] [--limit 1..50] [--cursor <opaque>]
  crewdeck status --diagnostic <id>   # explicit legacy full record
  crewdeck collect [id|inbox-key ...] [--keep-reports]
  crewdeck read-result <id|exact-candidate-key>
  crewdeck diff <build-id>
  crewdeck prompt <id> <message> [--wait]
  crewdeck forward-review <review-id> [--wait]
  crewdeck resume <reviewed-pr-build-id>
  crewdeck publish <build-id> --remote <name> --repo <owner/name> --base <branch> --head <branch> --title <text> --body <text>
  crewdeck reconcile-verdict <build-id> --confirm --reason <text>
  crewdeck observe-prs [build-id]
  crewdeck forward-base-advance <build-id> [--sequence <n>] [--wait]
  crewdeck extend-review-rounds <build-id> --current-max <n> --new-max <n> --confirm --reason <text>
  crewdeck retire-agent <id> --confirm --reason <text> [--terminate]
  crewdeck lock-status
  crewdeck recover-lock --confirm --reason <text>
  crewdeck prepare <id>
  crewdeck merge <id> --confirm
  crewdeck abandon <id> --confirm [--reason <text>]
  crewdeck reconcile-merged-pr <reviewed-pr-build-id> --confirm
  crewdeck reconcile-orphan <report-id> --confirm --reason <text>
  crewdeck cleanup <id> --confirm

State: ${stateLocation()}
Config: ${configPath}`);
}

function option(name) {
  const index = args.indexOf(name);
  return index >= 0 ? args[index + 1] : undefined;
}

try {
  let result;
  switch (command) {
    case "config":
      result = await loadConfig(configPath);
      delete result.__path;
      delete result.__kindsPath;
      delete result.__profilesPath;
      for (const kind of Object.values(result.kinds)) delete kind.resolvedSkills;
      break;
    case "project": {
      if (args[0] === "list") {
        const config = await loadConfig(configPath);
        result = config.projects;
      } else if (args[0] === "add" && args[1] && args[2]) {
        result = await addProject(configPath, args[1], args[2], {
          base: option("--base"),
          baseRemote: option("--base-remote"),
          trustProjectResources: args.includes("--trust"),
        });
      } else {
        usage();
        process.exitCode = 2;
      }
      break;
    }
    case "spawn": {
      if (!args[0] || !args[1] || !args[2] || !args[3]) {
        throw new Error("spawn requires <project> <kind> <id> <task>");
      }
      result = await spawnBatch(configPath, {
        project: args[0],
        tasks: [{
          kind: args[1],
          id: args[2],
          task: args[3],
          profile: option("--profile"),
          workflow: args.includes("--reviewed-pr") ? "reviewed-pr" : "direct",
        }],
      });
      break;
    }
    case "review": {
      if (!args[0] || !args[1] || !args[2] || !args[3]) {
        throw new Error("review requires <parent-id> <review-id> <reviewed-head> <task>");
      }
      result = await spawnReview(configPath, {
        parentTaskId: args[0],
        id: args[1],
        reviewedHead: args[2],
        task: args[3],
        profile: option("--profile"),
      });
      break;
    }
    case "status": {
      let id;
      let diagnostic = false;
      let scope;
      let limit;
      let cursor;
      for (let index = 0; index < args.length; index += 1) {
        const argument = args[index];
        if (argument === "--summary") continue; // backward-compatible no-op: bounded is now the default.
        if (argument === "--diagnostic") {
          diagnostic = true;
          continue;
        }
        if (["--scope", "--limit", "--cursor"].includes(argument)) {
          const value = args[index + 1];
          if (value === undefined || value.startsWith("--")) throw new Error(`${argument} requires a value`);
          index += 1;
          if (argument === "--scope") scope = value;
          else if (argument === "--limit") {
            if (!/^[0-9]+$/.test(value)) throw new Error("--limit must be a positive safe integer");
            limit = Number(value);
            if (!Number.isSafeInteger(limit)) throw new Error("--limit must be a positive safe integer");
          } else {
            cursor = /^[0-9]+$/.test(value) ? Number(value) : value;
            if (typeof cursor === "number" && !Number.isSafeInteger(cursor)) throw new Error("--cursor integer must be safe");
          }
          continue;
        }
        if (argument.startsWith("--")) throw new Error(`Unknown status option '${argument}'`);
        if (id !== undefined) throw new Error("status accepts at most one task id");
        id = argument;
      }
      result = await getStatusView(configPath, { id, mode: diagnostic ? "diagnostic" : "bounded", scope, limit, cursor });
      break;
    }
    case "collect":
      result = await collectResults(
        configPath,
        args.filter((arg) => !arg.startsWith("--")),
        { cleanupReports: !args.includes("--keep-reports") && !args.includes("--keep-scouts") },
      );
      break;
    case "read-result":
      if (!args[0] || args.length !== 1) throw new Error("read-result requires exactly one result id or exact candidate key");
      result = await readResultDetail(configPath, args[0]);
      break;
    case "diff":
      if (!args[0]) throw new Error("diff requires <build-id>");
      result = await getTaskDiff(configPath, args[0]);
      break;
    case "prompt":
      if (!args[0] || !args[1]) throw new Error("prompt requires <id> <message>");
      result = await promptTask(configPath, args[0], args[1], { wait: args.includes("--wait") });
      break;
    case "forward-review":
      if (!args[0]) throw new Error("forward-review requires <review-id>");
      result = await forwardReviewFindings(configPath, args[0], { wait: args.includes("--wait") });
      break;
    case "resume":
      if (!args[0]) throw new Error("resume requires <reviewed-pr-build-id>");
      result = await resumeBuild(configPath, args[0]);
      break;
    case "publish": {
      const required = ["--remote", "--repo", "--base", "--head", "--title", "--body"];
      if (!args[0] || required.some((name) => !option(name))) {
        throw new Error("publish requires <id> --remote --repo --base --head --title --body");
      }
      result = await publishPullRequest(configPath, args[0], {
        remote: option("--remote"),
        repo: option("--repo"),
        base: option("--base"),
        head: option("--head"),
        title: option("--title"),
        body: option("--body"),
      });
      break;
    }
    case "reconcile-verdict":
      if (!args[0] || !args.includes("--confirm") || !option("--reason")) throw new Error("reconcile-verdict requires <id> --confirm --reason <text>");
      result = await reconcileVerdictComment(configPath, args[0], { reason: option("--reason") });
      break;
    case "observe-prs":
      result = await observePublishedPullRequests(configPath, args[0]);
      break;
    case "forward-base-advance": {
      if (!args[0]) throw new Error("forward-base-advance requires <build-id> [--sequence <n>] [--wait]");
      const sequenceText = option("--sequence");
      const sequence = sequenceText === undefined ? undefined : Number(sequenceText);
      if (sequence !== undefined && (!/^[1-9][0-9]*$/.test(sequenceText) || !Number.isSafeInteger(sequence))) throw new Error("--sequence must be a positive safe integer");
      result = await forwardBaseAdvance(configPath, args[0], sequence, { wait: args.includes("--wait") });
      break;
    }
    case "extend-review-rounds":
      if (!args[0] || !args.includes("--confirm") || !option("--reason") || !option("--current-max") || !option("--new-max")) {
        throw new Error("extend-review-rounds requires <id> --current-max <n> --new-max <n> --confirm --reason <text>");
      }
      result = await extendReviewRounds(configPath, args[0], { currentMax: Number(option("--current-max")), newMax: Number(option("--new-max")), reason: option("--reason") });
      break;
    case "retire-agent":
      if (!args[0] || !args.includes("--confirm") || !option("--reason")) throw new Error("retire-agent requires <id> --confirm --reason <text> [--terminate]");
      result = await retireTaskAgent(configPath, args[0], { reason: option("--reason"), terminate: args.includes("--terminate") });
      break;
    case "lock-status":
      result = await stateLockStatus();
      break;
    case "recover-lock":
      if (!args.includes("--confirm") || !option("--reason")) throw new Error("recover-lock requires --confirm --reason <text>");
      result = await recoverStateLock({ reason: option("--reason") });
      break;
    case "prepare":
      if (!args[0]) throw new Error("prepare requires <id>");
      result = await prepareIntegration(configPath, args[0]);
      break;
    case "merge":
      if (!args[0] || !args.includes("--confirm")) throw new Error("merge requires <id> --confirm");
      result = await mergeTask(configPath, args[0]);
      break;
    case "abandon":
      if (!args[0] || !args.includes("--confirm")) throw new Error("abandon requires <id> --confirm");
      result = await abandonTask(configPath, args[0], { reason: option("--reason") });
      break;
    case "reconcile-merged-pr":
      if (!args[0] || !args.includes("--confirm")) {
        throw new Error("reconcile-merged-pr requires <reviewed-pr-build-id> --confirm");
      }
      result = await reconcileMergedPullRequest(configPath, args[0]);
      break;
    case "reconcile-orphan":
      if (!args[0] || !args.includes("--confirm") || !option("--reason")) {
        throw new Error("reconcile-orphan requires <id> --confirm --reason <text>");
      }
      result = await reconcileOrphanReport(configPath, args[0], { reason: option("--reason") });
      break;
    case "cleanup":
      if (!args[0] || !args.includes("--confirm")) throw new Error("cleanup requires <id> --confirm");
      result = await cleanupTask(configPath, args[0]);
      break;
    case "help":
    case "--help":
    case "-h":
    case undefined:
      usage();
      break;
    default:
      usage();
      process.exitCode = 2;
  }
  if (result !== undefined) console.log(JSON.stringify(result, null, 2));
} catch (error) {
  console.error(JSON.stringify({ error: error.message, code: error.code || "error", details: error.details }, null, 2));
  process.exitCode = 1;
}
