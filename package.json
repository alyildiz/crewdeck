{
  "name": "crewdeck",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Lightweight Pi and Herdr orchestrator for coding agents in isolated Git worktrees",
  "bin": {
    "crewdeck": "bin/crewdeck"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/core.mjs && node --check bin/crewdeck"
  },
  "pi": {
    "extensions": [
      "./.pi/extensions/crewdeck/index.ts"
    ],
    "skills": [
      "./.agents/skills/crewdeck"
    ]
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
